# BIRD meshctl managed configuration for {{ .Node.Name }}
# Generated by meshctl — do not edit manually
# Compatible with BIRD 2.x (OSPFv3 requires separate instances per AF)

# Loopback /32 stub — advertised into OSPF
protocol static meshctl_lo4 {
    ipv4 { table {{ .Global.IGPTable4 }}; };
    route {{ .Node.Loopback }}/32 via "lo";
}

{{ if .Fe80Links -}}
# OSPFv3 IPv4 AF (RFC 5838) — fe80 neighbor sessions, carries IPv4 routes.
# Instance ID 64 per RFC 5838 §2.1 (IPv4 unicast AF). Linux<->Linux only:
# RouterOS lacks RFC 5838, so its IPv4 routes ride OSPFv2 (meshctl_ospf2) below.
# Requires 169.254.x.x PTP addresses on interfaces for IPv4 nexthop resolution.
protocol ospf v3 meshctl_ospf3_v4 {
    ipv4 {
        table {{ .Global.IGPTable4 }};
        import all;
        export all;
    };
    instance id 64;
    area {{ .Global.OSPFArea }} {
        {{- range .Fe80Links }}
        interface "{{ peerIface $.PeerIfaces (.PeerName $.Node.Name) }}" {
            type pointopoint;
            hello {{ $.Global.OSPFHello }};
            dead {{ $.Global.OSPFDead }};
            cost {{ peerCost $.PeerCosts (.PeerName $.Node.Name) }};
        };
        {{- end }}
    };
}
{{ end -}}

{{ if .Links -}}
# OSPFv3 IPv6 (native) — fe80 neighbor sessions, carries IPv6 routes.
# Runs over ALL links: every WG interface has an fe80::127:<id> address and
# native OSPFv3 is universal (RFC 5838 only limits the IPv4 AF instance above).
# RouterOS and static peers therefore get IPv6 over the same tunnels whose
# IPv4 rides OSPFv2.
protocol ospf v3 meshctl_ospf3_v6 {
    ipv6 {
        table {{ .Global.IGPTable6 }};
        import all;
        export all;
    };
    area {{ .Global.OSPFArea }} {
        {{- range .Links }}
        interface "{{ peerIface $.PeerIfaces (.PeerName $.Node.Name) }}" {
            type pointopoint;
            hello {{ $.Global.OSPFHello }};
            dead {{ $.Global.OSPFDead }};
            cost {{ peerCost $.PeerCosts (.PeerName $.Node.Name) }};
        };
        {{- end }}
    };
}
{{ end -}}

{{ if .V4LLLinks -}}
# OSPFv2 for 169.254.x.x links (RouterOS / static peers) — IPv4 only.
# IPv6 for these same links rides meshctl_ospf3_v6 (native OSPFv3) above.
protocol ospf v2 meshctl_ospf2 {
    ipv4 {
        table {{ .Global.IGPTable4 }};
        import all;
        export all;
    };
    area {{ .Global.OSPFArea }} {
        {{- range .V4LLLinks }}
        interface "{{ peerIface $.PeerIfaces (.PeerName $.Node.Name) }}" {
            type pointopoint;
            hello {{ $.Global.OSPFHello }};
            dead {{ $.Global.OSPFDead }};
            cost {{ peerCost $.PeerCosts (.PeerName $.Node.Name) }};
        };
        {{- end }}
    };
}
{{ end -}}
